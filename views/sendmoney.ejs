<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 col-xl-5">
      <div class="glass-card p-4 shadow-lg">
        
        <div class="text-center mb-4">
          <h2 class="fw-bold mb-1"><i class="bi bi-send text-gradient-primary me-2"></i>Send Money</h2>
          <p class="text-secondary small">Transfer funds securely in real-time to other EchoPay users</p>
        </div>

        <!-- Success Alert -->
        <% if (success) { %>
          <div class="alert alert-success d-flex align-items-center small py-2.5 px-3 mb-4 border-0 rounded-3 bg-success-subtle text-success" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div class="fw-semibold"><%= success %></div>
          </div>
        <% } %>

        <!-- Error Alert -->
        <% if (error) { %>
          <div class="alert alert-danger d-flex align-items-center small py-2.5 px-3 mb-4 border-0 rounded-3 bg-danger-subtle text-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div class="fw-semibold"><%= error %></div>
          </div>
        <% } %>

        <!-- Transaction Form -->
        <form method="POST" action="/sendmoney" autocomplete="off" id="sendMoneyForm">
          
          <!-- Sender (Read-only) -->
          <div class="mb-3">
            <label class="form-label small fw-bold">From Account</label>
            <div class="input-group">
              <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-person-fill text-muted"></i></span>
              <input type="text" value="<%= currentUser.username %> (You)" class="form-control border-start-0 ps-0 bg-body-tertiary fw-semibold" readonly />
            </div>
          </div>

          <!-- Receiver Search (Autocomplete) -->
          <div class="mb-3 autocomplete-wrapper">
            <label class="form-label small fw-bold">Receiver Username</label>
            <div class="input-group">
              <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-person-check text-muted"></i></span>
              <input type="text" id="receiverSearchInput" name="receiver_username" class="form-control border-start-0 ps-0 bg-body-tertiary" placeholder="Type username to search..." required />
            </div>
            <!-- Auto-complete Dropdown container -->
            <div id="autocompleteList" class="autocomplete-items d-none"></div>
            <div class="form-text small text-secondary">Start typing and select a registered user.</div>
          </div>

          <!-- Amount -->
          <div class="mb-3">
            <label class="form-label small fw-bold">Amount (₹)</label>
            <div class="input-group">
              <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-currency-rupee text-muted"></i></span>
              <input type="number" id="transferAmount" name="amount" step="0.01" min="0.01" class="form-control border-start-0 ps-0 bg-body-tertiary fw-bold text-primary" placeholder="0.00" required />
            </div>
            <div class="form-text small text-secondary">Make sure you have sufficient funds to complete the transfer.</div>
          </div>

          <!-- Purpose -->
          <div class="mb-4">
            <label class="form-label small fw-bold">Purpose / Category</label>
            <div class="input-group">
              <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-tag text-muted"></i></span>
              <select name="purpose" class="form-select border-start-0 ps-0 bg-body-tertiary" required>
                <option value="" disabled selected>Select expense category</option>
                <option value="Groceries">Groceries</option>
                <option value="Rent">Rent</option>
                <option value="Bills & Utility">Bills & Utility</option>
                <option value="Entertainment">Entertainment</option>
                <option value="Travel">Travel</option>
                <option value="Shopping">Shopping</option>
                <option value="General">General / Other</option>
              </select>
            </div>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="btn btn-primary w-100 py-2.5 fw-semibold d-flex align-items-center justify-content-center">
            <i class="bi bi-shield-lock-fill me-2"></i>Authorize Transfer
          </button>
        </form>

      </div>
    </div>
  </div>
</div>

<!-- Autocomplete Suggestion Logic -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('receiverSearchInput');
    const autocompleteList = document.getElementById('autocompleteList');
    let debounceTimer;

    if (searchInput && autocompleteList) {
      // Listen to input typing
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.trim();
        
        clearTimeout(debounceTimer);
        if (query.length < 1) {
          closeSuggestions();
          return;
        }

        // Debounce API requests (200ms)
        debounceTimer = setTimeout(async () => {
          try {
            const response = await fetch(`/api/users/search?q=${encodeURIComponent(query)}`);
            const data = await response.json();
            
            if (data.users && data.users.length > 0) {
              renderSuggestions(data.users);
            } else {
              renderNoResults();
            }
          } catch (err) {
            console.error("Failed to query autocomplete API:", err);
          }
        }, 200);
      });

      // Close dropdown if user clicks outside
      document.addEventListener('click', (e) => {
        if (!searchInput.contains(e.target) && !autocompleteList.contains(e.target)) {
          closeSuggestions();
        }
      });
    }

    function renderSuggestions(users) {
      autocompleteList.innerHTML = '';
      autocompleteList.classList.remove('d-none');
      
      users.forEach(u => {
        const item = document.createElement('div');
        item.className = 'autocomplete-item';
        item.innerHTML = `<i class="bi bi-person-fill me-2 text-secondary"></i><strong>${u.username}</strong>`;
        
        // Select recommendation handler
        item.addEventListener('click', () => {
          searchInput.value = u.username;
          closeSuggestions();
        });
        
        autocompleteList.appendChild(item);
      });
    }

    function renderNoResults() {
      autocompleteList.innerHTML = '';
      autocompleteList.classList.remove('d-none');
      
      const item = document.createElement('div');
      item.className = 'autocomplete-item text-secondary disabled small';
      item.innerHTML = `<i class="bi bi-person-slash me-2"></i>No matching users found`;
      autocompleteList.appendChild(item);
    }

    function closeSuggestions() {
      autocompleteList.classList.add('d-none');
      autocompleteList.innerHTML = '';
    }
  });
</script>
