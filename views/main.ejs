<div class="container-fluid px-lg-4">
  <!-- Welcome and Balance Row -->
  <div class="row align-items-center mb-4 gy-3">
    <div class="col-md-6">
      <h2 class="fw-extrabold mb-0">Welcome Back, <span class="text-gradient-primary"><%= user.username %></span></h2>
      <p class="text-secondary mb-0">Track and visualize your monthly financial activities below.</p>
    </div>
    <div class="col-md-6 text-md-end">
      <div class="d-inline-flex align-items-center glass-card px-4 py-3 shadow-sm">
        <div class="me-3 text-start">
          <span class="text-secondary small fw-bold d-block text-uppercase tracking-wider">Available Balance</span>
          <span class="h3 fw-extrabold mb-0 text-gradient-primary">₹<%= Number(user.balance).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
        </div>
        <div class="fs-1 text-primary-gradient"><i class="bi bi-wallet2"></i></div>
      </div>
    </div>
  </div>

  <!-- Quick Metrics Grid -->
  <div class="row g-4 mb-4">
    <div class="col-6 col-lg-3">
      <div class="glass-card p-3 shadow-sm border-start border-primary border-4">
        <span class="text-secondary small fw-semibold">Total Sent (Filtered)</span>
        <h4 class="fw-bold mt-2 mb-0" id="totalSentMetric">₹0.00</h4>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="glass-card p-3 shadow-sm border-start border-success border-4">
        <span class="text-secondary small fw-semibold">Total Received (Filtered)</span>
        <h4 class="fw-bold mt-2 mb-0" id="totalReceivedMetric">₹0.00</h4>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="glass-card p-3 shadow-sm border-start border-info border-4">
        <span class="text-secondary small fw-semibold">Net Transactions</span>
        <h4 class="fw-bold mt-2 mb-0" id="netFlowMetric">₹0.00</h4>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="glass-card p-3 shadow-sm border-start border-warning border-4">
        <span class="text-secondary small fw-semibold">Active Period</span>
        <h4 class="fw-bold mt-2 mb-0" id="activePeriodMetric">All Time</h4>
      </div>
    </div>
  </div>

  <!-- Filters & Date Selector -->
  <div class="glass-card p-4 mb-4 shadow-sm">
    <div class="row align-items-center">
      <div class="col-lg-3">
        <h5 class="fw-bold mb-2 mb-lg-0"><i class="bi bi-funnel-fill text-primary me-2"></i>Filter Transactions</h5>
      </div>
      <div class="col-lg-9">
        <form id="filterForm" class="row g-3 justify-content-lg-end">
          <div class="col-sm-4">
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-body-tertiary">From</span>
              <input type="date" id="startDate" name="start" class="form-control" max="<%= new Date().toISOString().split('T')[0] %>">
            </div>
          </div>
          <div class="col-sm-4">
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-body-tertiary">To</span>
              <input type="date" id="endDate" name="end" class="form-control" max="<%= new Date().toISOString().split('T')[0] %>">
            </div>
          </div>
          <div class="col-sm-4 col-md-3 col-lg-2">
            <button type="submit" class="btn btn-primary btn-sm w-100 py-2 fw-semibold">Apply Filters</button>
          </div>
          <div class="col-sm-4 col-md-3 col-lg-2">
            <button type="button" id="resetFiltersBtn" class="btn btn-outline-secondary btn-sm w-100 py-2 fw-semibold">Reset</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Charts Row -->
  <div class="row g-4 mb-4">
    <!-- Bar charts -->
    <div class="col-xl-8">
      <div class="glass-card p-4 shadow-sm h-100">
        <h5 class="fw-bold mb-4"><i class="bi bi-graph-up-arrow text-primary me-2"></i>Monthly Volume Sent & Received</h5>
        <div style="height: 350px;">
          <canvas id="barChart"></canvas>
        </div>
      </div>
    </div>
    
    <!-- Pie Chart -->
    <div class="col-xl-4">
      <div class="glass-card p-4 shadow-sm h-100">
        <h5 class="fw-bold mb-4"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Expenses by Purpose</h5>
        <div style="height: 350px;" class="d-flex align-items-center justify-content-center">
          <canvas id="pieChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Detailed Transactions List -->
  <div class="glass-card p-4 shadow-sm mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="fw-bold mb-0"><i class="bi bi-list-stars text-primary me-2"></i>Recent Activity</h5>
      <a href="/history" class="btn btn-outline-primary btn-sm px-3 fw-semibold">View All History</a>
    </div>
    
    <div class="table-responsive">
      <table class="table align-middle" id="transactionsTable">
        <thead>
          <tr>
            <th scope="col" class="text-secondary small fw-bold">Date & Time</th>
            <th scope="col" class="text-secondary small fw-bold">Transaction ID</th>
            <th scope="col" class="text-secondary small fw-bold">Type</th>
            <th scope="col" class="text-secondary small fw-bold">Sender / Receiver</th>
            <th scope="col" class="text-secondary small fw-bold">Purpose</th>
            <th scope="col" class="text-secondary small fw-bold text-end">Amount</th>
          </tr>
        </thead>
        <tbody>
          <!-- Dynamic content loaded via JS -->
        </tbody>
      </table>
    </div>
    <div class="text-center py-4 d-none" id="noTransactionsNotice">
      <i class="bi bi-clipboard-x text-muted display-4 mb-2 d-block"></i>
      <span class="text-secondary">No transactions found for the selected filter criteria.</span>
    </div>
  </div>
</div>

<!-- Chart.js and Dashboard Script -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // Global reference variables
  const currentUser = "<%= user.username %>";
  let initialTransactions = [];
  try {
    initialTransactions = JSON.parse(decodeURIComponent("<%= encodeURIComponent(JSON.stringify(transactions)) %>"));
  } catch(e) {
    console.error("Error parsing transactions data:", e);
  }

  let barChartInstance = null;
  let pieChartInstance = null;

  document.addEventListener('DOMContentLoaded', () => {
    // Render initial dataset
    updateDashboard(initialTransactions);

    // Filter Form submit handler
    const filterForm = document.getElementById('filterForm');
    filterForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const start = document.getElementById('startDate').value;
      const end = document.getElementById('endDate').value;
      
      if (!start || !end) return alert("Please select both Start and End dates.");
      
      try {
        const response = await fetch(`/api/transactions?start=${start}&end=${end}`);
        const data = await response.json();
        if (data.transactions) {
          updateDashboard(data.transactions, { start, end });
        }
      } catch (err) {
        console.error("Failed to query transactions API:", err);
      }
    });

    // Reset Filters button handler
    const resetBtn = document.getElementById('resetFiltersBtn');
    resetBtn.addEventListener('click', () => {
      document.getElementById('startDate').value = '';
      document.getElementById('endDate').value = '';
      updateDashboard(initialTransactions, null);
    });
  });

  // Calculate stats, rebuild charts and update UI
  function updateDashboard(transactions, period) {
    let totalSent = 0;
    let totalReceived = 0;
    
    // Maps for charts
    const purposeMap = {};
    const monthlyData = {}; // Format: { 'January': { sent: 0, received: 0 } }

    transactions.forEach(t => {
      const amount = Number(t.amount);
      const isSent = t.sender_name === currentUser;
      
      // Calculate sums
      if (isSent) {
        totalSent += amount;
      } else {
        totalReceived += amount;
      }

      // Group by Purpose (for expense pie chart)
      if (isSent) {
        const purpose = t.purpose || 'General';
        purposeMap[purpose] = (purposeMap[purpose] || 0) + amount;
      }

      // Group by month (for volume bar chart)
      const month = t.month || 'Unknown';
      if (!monthlyData[month]) {
        monthlyData[month] = { sent: 0, received: 0 };
      }
      if (isSent) {
        monthlyData[month].sent += amount;
      } else {
        monthlyData[month].received += amount;
      }
    });

    // Update Quick Metric numbers
    document.getElementById('totalSentMetric').innerText = `₹${totalSent.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    document.getElementById('totalReceivedMetric').innerText = `₹${totalReceived.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    
    const net = totalReceived - totalSent;
    const netMetric = document.getElementById('netFlowMetric');
    netMetric.innerText = `₹${net.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    if (net >= 0) {
      netMetric.className = "fw-bold mt-2 mb-0 text-success";
    } else {
      netMetric.className = "fw-bold mt-2 mb-0 text-danger";
    }

    // Active period display text
    const activePeriod = document.getElementById('activePeriodMetric');
    if (period) {
      activePeriod.innerText = `${period.start} to ${period.end}`;
      activePeriod.style.fontSize = '0.85rem';
    } else {
      activePeriod.innerText = 'All Time';
      activePeriod.style.fontSize = '1.5rem';
    }

    // Update transactions table
    const tableBody = document.querySelector('#transactionsTable tbody');
    const notice = document.getElementById('noTransactionsNotice');
    const table = document.getElementById('transactionsTable');
    
    tableBody.innerHTML = '';
    
    if (transactions.length === 0) {
      table.classList.add('d-none');
      notice.classList.remove('d-none');
    } else {
      table.classList.remove('d-none');
      notice.classList.add('d-none');

      // Only show top 8 transactions on dashboard to look clean
      const listLimit = transactions.slice(0, 8);
      
      listLimit.forEach(t => {
        const isSent = t.sender_name === currentUser;
        const formattedDate = new Date(t.created_at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' });
        
        const row = document.createElement('tr');
        row.innerHTML = `
          <td><span class="small fw-semibold text-secondary">${formattedDate}</span></td>
          <td><code class="small text-muted">${t.transaction_id.substring(0, 8)}...</code></td>
          <td>
            <span class="badge ${isSent ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success'} rounded-pill fw-semibold">
              ${isSent ? 'Sent' : 'Received'}
            </span>
          </td>
          <td>
            <span class="fw-semibold">${isSent ? t.receiver_name : t.sender_name}</span>
          </td>
          <td><span class="text-secondary small">${t.purpose}</span></td>
          <td class="text-end fw-bold ${isSent ? 'text-danger' : 'text-success'}">
            ${isSent ? '-' : '+'}₹${t.amount.toFixed(2)}
          </td>
        `;
        tableBody.appendChild(row);
      });
    }

    // Rebuild Charts
    renderBarChart(monthlyData);
    renderPieChart(purposeMap);
  }

  // Draw or update the multi-bar chart
  function renderBarChart(monthlyData) {
    const ctx = document.getElementById('barChart').getContext('2d');
    const labels = Object.keys(monthlyData);
    const sentData = [];
    const receivedData = [];

    labels.forEach(m => {
      sentData.push(monthlyData[m].sent);
      receivedData.push(monthlyData[m].received);
    });

    if (barChartInstance) {
      barChartInstance.destroy();
    }

    barChartInstance = new Chart(ctx, {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'Sent (₹)',
            data: sentData,
            backgroundColor: 'rgba(244, 63, 94, 0.85)', // Rose
            borderColor: '#f43f5e',
            borderWidth: 1,
            borderRadius: 6
          },
          {
            label: 'Received (₹)',
            data: receivedData,
            backgroundColor: 'rgba(16, 185, 129, 0.85)', // Emerald
            borderColor: '#10b981',
            borderWidth: 1,
            borderRadius: 6
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              font: { family: 'Outfit' }
            }
          },
          x: {
            ticks: {
              font: { family: 'Outfit' }
            }
          }
        },
        plugins: {
          legend: {
            labels: { font: { family: 'Outfit', weight: 'bold' } }
          }
        }
      }
    });
  }

  // Draw or update the purpose pie chart
  function renderPieChart(purposeMap) {
    const ctx = document.getElementById('pieChart').getContext('2d');
    const labels = Object.keys(purposeMap);
    const data = Object.values(purposeMap);

    if (pieChartInstance) {
      pieChartInstance.destroy();
    }

    if (labels.length === 0) {
      // Draw placeholder pie chart if no expenses exist
      pieChartInstance = new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: ['No Sent Expenses'],
          datasets: [{
            data: [1],
            backgroundColor: ['rgba(100, 116, 139, 0.1)'],
            borderColor: ['rgba(100, 116, 139, 0.2)'],
            borderWidth: 1
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: { enabled: false }
          }
        }
      });
      return;
    }

    pieChartInstance = new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: labels,
        datasets: [{
          data: data,
          backgroundColor: [
            'rgba(79, 70, 229, 0.8)',  // Indigo
            'rgba(6, 182, 212, 0.8)',  // Cyan
            'rgba(251, 146, 60, 0.8)', // Orange
            'rgba(244, 63, 94, 0.8)',  // Rose
            'rgba(16, 185, 129, 0.8)',  // Emerald
            'rgba(168, 85, 247, 0.8)'   // Purple
          ],
          borderColor: [
            '#4f46e5', '#06b6d4', '#fb923c', '#f43f5e', '#10b981', '#a855f7'
          ],
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              font: { family: 'Outfit' },
              boxWidth: 12
            }
          }
        }
      }
    });
  }
</script>
