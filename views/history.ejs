<div class="container py-4">
  <div class="glass-card p-4 shadow-lg">
    <!-- Header -->
    <div class="row align-items-center mb-4 gy-3">
      <div class="col-md-6">
        <h2 class="fw-extrabold mb-1"><i class="bi bi-clock-history text-primary me-2"></i>Transaction Ledger</h2>
        <p class="text-secondary small mb-0">View all incoming and outgoing transfers associated with your account</p>
      </div>
      <!-- Local Instant Search -->
      <div class="col-md-6 text-md-end">
        <div class="input-group">
          <span class="input-group-text bg-body-tertiary"><i class="bi bi-search text-muted"></i></span>
          <input type="text" id="ledgerSearchInput" class="form-control bg-body-tertiary" placeholder="Search by recipient, sender, or purpose...">
        </div>
      </div>
    </div>

    <!-- Summary Count -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <span class="text-secondary small fw-semibold" id="ledgerSummaryText">Loading transactions...</span>
    </div>

    <!-- Table -->
    <div class="table-responsive">
      <table class="table align-middle" id="historyTable">
        <thead>
          <tr>
            <th scope="col" class="text-secondary small fw-bold">Date & Time</th>
            <th scope="col" class="text-secondary small fw-bold">Transaction ID</th>
            <th scope="col" class="text-secondary small fw-bold">Type</th>
            <th scope="col" class="text-secondary small fw-bold">Sender</th>
            <th scope="col" class="text-secondary small fw-bold">Receiver</th>
            <th scope="col" class="text-secondary small fw-bold">Purpose</th>
            <th scope="col" class="text-secondary small fw-bold text-end">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% if (transactions.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center py-5 text-secondary">
                <i class="bi bi-clipboard-x display-4 d-block mb-2 text-muted"></i>
                No transactions found. Go to "Send Money" to perform your first transaction!
              </td>
            </tr>
          <% } else { %>
            <% transactions.forEach(t => { 
                 const isSent = t.sender_name === user.username;
                 const formattedDate = new Date(t.created_at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' });
            %>
              <tr class="ledger-row" data-search="<%= (t.sender_name + ' ' + t.receiver_name + ' ' + t.purpose).toLowerCase() %>">
                <td><span class="small fw-semibold text-secondary"><%= formattedDate %></span></td>
                <td><code class="small text-muted"><%= t.transaction_id %></code></td>
                <td>
                  <span class="badge <%= isSent ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success' %> rounded-pill fw-semibold">
                    <%= isSent ? 'Sent' : 'Received' %>
                  </span>
                </td>
                <td><span class="fw-semibold"><%= t.sender_name %></span></td>
                <td><span class="fw-semibold"><%= t.receiver_name %></span></td>
                <td><span class="text-secondary small"><%= t.purpose %></span></td>
                <td class="text-end fw-bold <%= isSent ? 'text-danger' : 'text-success' %>">
                  <%= isSent ? '-' : '+' %>₹<%= Number(t.amount).toFixed(2) %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('ledgerSearchInput');
    const rows = document.querySelectorAll('.ledger-row');
    const summaryText = document.getElementById('ledgerSummaryText');

    // Update total count initially
    updateSummaryText(rows.length);

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        let visibleCount = 0;

        rows.forEach(row => {
          const searchContent = row.getAttribute('data-search');
          if (searchContent.includes(query)) {
            row.classList.remove('d-none');
            visibleCount++;
          } else {
            row.classList.add('d-none');
          }
        });

        updateSummaryText(visibleCount);
      });
    }

    function updateSummaryText(count) {
      if (summaryText) {
        summaryText.innerText = `Showing ${count} transaction${count === 1 ? '' : 's'}`;
      }
    }
  });
</script>
