<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 col-xl-5">
      <div class="glass-card p-4 shadow-lg">
        <div class="text-center mb-4">
          <h2 class="fw-bold mb-1">Create Account</h2>
          <p class="text-secondary small">Join EchoPay for secure visual financial tracking</p>
        </div>

        <% if (errors && errors.length > 0) { %>
          <div class="alert alert-danger border-0 rounded-3 bg-danger-subtle text-danger py-2.5 px-3 mb-4">
            <div class="d-flex align-items-center mb-2 fw-semibold small">
              <i class="bi bi-exclamation-octagon-fill me-2"></i>Please resolve the following errors:
            </div>
            <ul class="mb-0 ps-3 small">
              <% errors.forEach(err => { %>
                <li><%= err.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form action="/signup" method="POST">
          <div class="mb-3">
            <label for="username" class="form-label small fw-bold">Username</label>
            <div class="input-group">
              <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-person text-muted"></i></span>
              <input type="text" class="form-control border-start-0 ps-0 bg-body-tertiary" id="username" name="username" 
                     placeholder="Choose a username" value="<%= formData.username || '' %>" required>
            </div>
          </div>
          
          <div class="mb-3">
            <label for="email" class="form-label small fw-bold">Email Address</label>
            <div class="input-group">
              <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-envelope text-muted"></i></span>
              <input type="email" class="form-control border-start-0 ps-0 bg-body-tertiary" id="email" name="email" 
                     placeholder="email@example.com" value="<%= formData.email || '' %>" required>
            </div>
          </div>
          
          <div class="mb-3">
            <label for="password" class="form-label small fw-bold">Password</label>
            <div class="input-group">
              <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-lock text-muted"></i></span>
              <input type="password" class="form-control border-start-0 ps-0 bg-body-tertiary" id="password" name="password" 
                     placeholder="Create a strong password" required>
            </div>
            <div class="form-text small text-secondary">Must be 8+ characters, with at least 1 uppercase letter and 1 number.</div>
          </div>
          
          <div class="mb-3">
            <label for="confirmPassword" class="form-label small fw-bold">Confirm Password</label>
            <div class="input-group">
              <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-shield-check text-muted"></i></span>
              <input type="password" class="form-control border-start-0 ps-0 bg-body-tertiary" id="confirmPassword" name="confirmPassword" 
                     placeholder="Verify your password" required>
            </div>
          </div>
          
          <div class="mb-4">
            <label for="initialAmount" class="form-label small fw-bold">Initial Account Balance (₹)</label>
            <div class="input-group">
              <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-currency-rupee text-muted"></i></span>
              <input type="number" class="form-control border-start-0 ps-0 bg-body-tertiary" id="initialAmount" name="initialAmount" 
                     placeholder="e.g. 5000" min="0" step="0.01" value="<%= formData.initialAmount || '' %>" required>
            </div>
            <div class="form-text small text-secondary">Set up your initial deposit amount to begin.</div>
          </div>
          
          <div class="mb-4 form-check">
            <input type="checkbox" class="form-check-input" id="termsAgree" name="termsAgree" required>
            <label class="form-check-label text-secondary small" for="termsAgree">
              I agree to the <a href="#" class="text-gradient-primary fw-bold text-decoration-none">Terms of Service</a> & <a href="#" class="text-gradient-primary fw-bold text-decoration-none">Privacy Policy</a>
            </label>
          </div>
          
          <button type="submit" class="btn btn-primary w-100 py-2.5">Create Account</button>
        </form>

        <div class="text-center mt-4">
          <p class="small text-secondary mb-0">Already have an account? <a href="/login" class="text-gradient-primary fw-bold text-decoration-none">Log in</a></p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const password = document.getElementById('password');
    const confirmPassword = document.getElementById('confirmPassword');
    
    function validatePassword() {
      if (password.value !== confirmPassword.value) {
        confirmPassword.setCustomValidity("Passwords don't match");
      } else {
        confirmPassword.setCustomValidity('');
      }
    }
    
    password.addEventListener('change', validatePassword);
    confirmPassword.addEventListener('keyup', validatePassword);
  });
</script>
