<!-- Hero Section -->
<section class="py-5 text-center text-lg-start">
  <div class="container">
    <div class="row align-items-center gy-5">
      <div class="col-lg-6">
        <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-2 mb-3 rounded-pill">Introducing EchoPay 1.0</span>
        <h1 class="display-3 fw-extrabold mb-3">
          Visualize Your <span class="text-gradient-primary">UPI Transactions</span> In Real Time
        </h1>
        <p class="lead text-secondary mb-4">
          Say goodbye to boring text message logs and chaotic bank statements. EchoPay converts raw UPI transfer records into beautiful, interactive, and category-wise charts.
        </p>
        <div class="d-flex flex-wrap justify-content-center justify-content-lg-start gap-3">
          <a href="/signup" class="btn btn-primary btn-lg px-4 py-3 btn-glow d-flex align-items-center">
            Get Started Free <i class="bi bi-arrow-right-short ms-1 fs-4"></i>
          </a>
          <a href="/login" class="btn btn-outline-secondary btn-lg px-4 py-3">
            Sign In Account
          </a>
        </div>
      </div>
      <div class="col-lg-6">
        <!-- Mock up Preview Panel -->
        <div class="glass-card p-4 shadow-lg card-hover">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="fw-bold text-muted"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Mock Analytics Preview</span>
            <span class="badge bg-success-subtle text-success">Live Demo</span>
          </div>
          <div class="chart-container-custom">
            <canvas id="previewPieChart"></canvas>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Core Features Section -->
<section class="py-5 bg-body-tertiary">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="h1 fw-bold">Why Choose <span class="text-gradient-primary">EchoPay</span>?</h2>
      <p class="text-secondary max-w-350 mx-auto">Get complete transparency over your personal finances with visual analytics.</p>
    </div>
    
    <div class="row g-4">
      <div class="col-md-4">
        <div class="glass-card p-4 h-100 card-hover shadow-sm">
          <div class="fs-1 text-primary mb-3"><i class="bi bi-bar-chart-steps"></i></div>
          <h4 class="fw-bold mb-2">Monthly Bar Charts</h4>
          <p class="text-secondary mb-0">Track exact monthly spending changes over time to monitor trends and optimize budgets.</p>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="glass-card p-4 h-100 card-hover shadow-sm">
          <div class="fs-1 text-primary mb-3"><i class="bi bi-tags-fill"></i></div>
          <h4 class="fw-bold mb-2">Purpose Categorization</h4>
          <p class="text-secondary mb-0">Auto-organize your payments under Rent, Groceries, Travel, bills, or dining for clean category insights.</p>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="glass-card p-4 h-100 card-hover shadow-sm">
          <div class="fs-1 text-primary mb-3"><i class="bi bi-shield-check"></i></div>
          <h4 class="fw-bold mb-2">Secure Transactions</h4>
          <p class="text-secondary mb-0">Engineered with high security hashing, ACID-compliant ledger transfers, and secure serverless states.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Include Chart.js (from CDN) for Mock Render -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const ctx = document.getElementById('previewPieChart').getContext('2d');
    
    // Custom HSL gradients for Chart
    new Chart(ctx, {
      type: 'pie',
      data: {
        labels: ['Groceries', 'Rent', 'Bills & Utility', 'Entertainment', 'Travel'],
        datasets: [{
          label: 'Amount by Purpose',
          data: [1500, 3500, 1200, 1800, 2000],
          backgroundColor: [
            'rgba(79, 70, 229, 0.75)',  // Indigo
            'rgba(6, 182, 212, 0.75)',  // Cyan
            'rgba(244, 63, 94, 0.75)',  // Rose
            'rgba(251, 146, 60, 0.75)', // Orange
            'rgba(16, 185, 129, 0.75)'  // Emerald
          ],
          borderColor: [
            '#4f46e5', '#06b6d4', '#f43f5e', '#fb923c', '#10b981'
          ],
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              font: {
                family: 'Outfit',
                weight: 'bold'
              },
              boxWidth: 12
            }
          }
        }
      }
    });
  });
</script>
