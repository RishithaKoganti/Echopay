# EchoPay Environment Variables Configuration Template
# Rename this file to .env and fill in the values below.

# Port for local development server
PORT=5003

# PostgreSQL Database Connection URI (Supabase or Neon connection string)
# Format: postgresql://username:password@hostname:port/database_name?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/echopay

# Express Session Secret (Any random long string)
SESSION_SECRET=your_super_secret_session_key
